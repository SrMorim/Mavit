# Production Environment Variables Example
# Copy this file to .env and update the values for production deployment

# Database Configuration
POSTGRES_DB=mavit_production
POSTGRES_USER=mavit_prod_user
POSTGRES_PASSWORD=your_super_secure_database_password_here

# Backend Configuration
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
ENCRYPTION_KEY=your_e2e_encryption_master_key_minimum_32_chars

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# Optional: Email Configuration (for password reset, etc.)
SMTP_HOST=smtp.youremailprovider.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@yourdomain.com

# Optional: SSL Configuration
SSL_CERT_PATH=/path/to/your/ssl/cert.pem
SSL_KEY_PATH=/path/to/your/ssl/private.key

# Security Settings
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info