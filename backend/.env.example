# Database Configuration
DATABASE_URL="postgresql://mavit_user:mavit_secure_password_2024@localhost:5432/mavit_db"

# JWT Configuration
JWT_SECRET="mavit_jwt_secret_key_super_secure_2024"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption Configuration (for E2E encryption)
ENCRYPTION_KEY="mavit_e2e_encryption_master_key_2024"
ENCRYPTION_ALGORITHM="AES-256-GCM"

# Server Configuration
NODE_ENV="development"
PORT="3001"
HOST="0.0.0.0"

# CORS Configuration
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# Email Configuration (for password recovery)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@mavit.app"

# Logging
LOG_LEVEL="info"
LOG_FILE="logs/mavit-backend.log"

# Security Headers
SECURITY_HEADER_CSP="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"

# File Upload (if needed later)
MAX_FILE_SIZE="10MB"
UPLOAD_PATH="uploads/"

# Session Configuration
SESSION_TIMEOUT="30"